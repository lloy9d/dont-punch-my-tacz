{
  "schemaVersion": 1,
  "id": "dontpunchmytacz",
  "version": "${version}",
  "name": "Don't Punch My TACZ",
  "description": "Fixes a first-person visual bug where guns glitch in hand. Automatically adds TACZ, SuperbWarfare, Create and Power Grid items to Punchy's first-person blacklist. Same as pressing F8, but automatic.",
  "authors": [
    "Don't Punch My TACZ"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/dont-punch-my-tacz",
    "sources": "https://github.com/lloy9d/dont-punch-my-tacz"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.dontpunchmytacz.DontPunchMyTacz"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": "1.20.1",
    "java": ">=17"
  },
  "recommends": {
    "punchy": "*"
  },
  "suggests": {
    "tacz": "*",
    "superbwarfare": "*"
  }
}
